# Copy to .env and fill in. Env vars override config/default.yaml.

# Path to a gensim KeyedVectors file (e.g. ~/glove/glove-100d.kv). When unset,
# word2vec.model_path from config is used, then the gensim downloader.
MOVIEREC_WORD2VEC_MODEL_PATH=

# Artifact store: local (./artifacts/, the default) or s3. s3 also needs the
# bucket name, from `terraform -chdir=infra output artifacts_bucket_name` (not secret,
# but account-specific, so it is not in config/default.yaml).
STORAGE_BACKEND=local
MOVIEREC_S3_BUCKET=
